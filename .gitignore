# 模型权重与缓存：体积大，从 ModelScope / Kaggle 重新拉取
models/
cache/
tmp/

# 模型、原始数据与归档禁止进入公共仓库
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.parquet
*.csv
*.zip
*.tar
*.tgz
*.tar.gz
*.npy
*.npz

# 本地凭据与私钥
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key

# 原始数据不进 git，但冻结后的评测集必须进（报告数字要能追溯）
data/*
!data/eval_set_v1.jsonl
!data/label_pool_v1.jsonl

# results/*.json 与 assets/ 要进 git，此处只挡日志
*.log
wandb/

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
